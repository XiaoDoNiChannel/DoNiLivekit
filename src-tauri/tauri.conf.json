{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "小豆泥电竞",
  "version": "0.1.5",
"identifier": "com.r.donichannel",
  "build": {
    "beforeDevCommand": "npm run frontend:dev",
    "beforeBuildCommand": "npm run frontend:build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DoNiChannel",
        "theme": "Dark",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/XiaoDoNiChannel/DoNiLivekit/releases/latest/download/latest-portable.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2OEZFRUFGNjgxMTI2OUMKUldTY0poRm9yKzZQZHNvVXc2NFhlN0pkMmdlQisyY284ZWkyaVB1UkR5MzJpbURYUEZxa2ZLcEMK"
    }
  }
}
